{
  "name": "july-annie-card-generator",
  "version": "0.0.0",
  "private": true,
  "description": "七月安妮公众号内容精简卡片生成器",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "assets:build": "node scripts/build-generated-backgrounds.mjs",
    "db:generate": "drizzle-kit generate",
    "db:seed": "node scripts/build-content-seed.mjs",
    "build": "npm run assets:build && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "drizzle-orm": "^0.45.2",
    "html-to-image": "^1.11.13",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "caniuse-lite": "^1.0.30001809",
    "drizzle-kit": "^0.31.10",
    "node-releases": "^2.0.53"
  }
}
